@model LoginViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["PageKey"] = "forgot-password";
}

<div class="page-shell">
    <div class="auth-panel">
        <h2 data-tr="Şifremi Unuttum" data-en="Forgot Password">Forgot Password</h2>
        <form class="login-form" onsubmit="handleForgotPassword(event)">
            <div class="form-group">
                <label data-tr="E-posta" data-en="Email">Email</label>
                <input type="email" id="forgotPasswordEmail" class="neon-input" required>
            </div>
            <div class="form-group">
                <label data-tr="Hesap Numarası" data-en="Account Number">Account Number</label>
                <input type="text" id="forgotPasswordAccountNo" class="neon-input" placeholder="VR-12345" required>
            </div>
            <div class="form-group">
                <label data-tr="Yeni Şifre" data-en="New Password">New Password</label>
                <input type="password" id="forgotPasswordNew" class="neon-input" required minlength="6">
            </div>
            <div class="form-group">
                <label data-tr="Yeni Şifre (Tekrar)" data-en="Confirm New Password">Confirm New Password</label>
                <input type="password" id="forgotPasswordConfirm" class="neon-input" required minlength="6">
            </div>
            <button type="submit" class="login-submit-btn" data-tr="Şifreyi Sıfırla" data-en="Reset Password">Reset Password</button>
        </form>
        <p class="auth-back"><a asp-controller="Account" asp-action="Login" data-tr="← Giriş" data-en="← Sign In">← Sign In</a></p>
    </div>
</div>
