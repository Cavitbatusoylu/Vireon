<div class="dash-sub-section active" id="dash-password">
                                <h2 class="sub-section-title" data-tr="Şifre Değiştir" data-en="Change Password">Change Password</h2>
                                <div class="glass-card transfer-card">
                                    <div class="transfer-form">
                                        <div class="form-group">
                                            <label data-tr="Mevcut şifre" data-en="Current password">Current password</label>
                                            <input type="password" id="pwdCurrent" class="neon-input" autocomplete="current-password">
                                        </div>
                                        <div class="form-group">
                                            <label data-tr="Yeni şifre" data-en="New password">New password</label>
                                            <input type="password" id="pwdNew" class="neon-input" autocomplete="new-password">
                                        </div>
                                        <div class="form-group">
                                            <label data-tr="Yeni şifre (tekrar)" data-en="Confirm new password">Confirm new password</label>
                                            <input type="password" id="pwdConfirm" class="neon-input" autocomplete="new-password">
                                        </div>
                                        <button type="button" class="login-submit-btn" onclick="handlePasswordChange()" data-tr="Şifreyi güncelle" data-en="Update password">Update password</button>
                                    </div>
                                </div>
                            </div>

