<div class="dash-sub-section active" id="dash-profile">
                                <div class="profile-layout-grid">
                                    <div class="profile-layout-left">
                                    <div class="profile-layout-account">
                                        <h2 class="sub-section-title" data-tr="Hesap Bilgileri" data-en="Account Details">Account Details</h2>
                                        <div class="glass-card transfer-card profile-settings-card">
                                            <div class="transfer-form">
                                                <div class="form-group">
                                                    <label data-tr="Ad" data-en="First name">First name</label>
                                                    <input type="text" id="profileName" class="neon-input" autocomplete="given-name">
                                                </div>
                                                <div class="form-group">
                                                    <label data-tr="Soyad" data-en="Last name">Last name</label>
                                                    <input type="text" id="profileSurname" class="neon-input" autocomplete="family-name">
                                                </div>
                                                <div class="form-group">
                                                    <label data-tr="E-posta" data-en="Email">Email</label>
                                                    <input type="email" id="profileEmail" class="neon-input" autocomplete="email">
                                                </div>
                                                <button type="button" class="login-submit-btn" onclick="handleProfileSave()" data-tr="Kaydet" data-en="Save">Save</button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="profile-layout-reset">
                                        <h2 class="sub-section-title" data-tr="Şifremi Unuttum" data-en="Forgot Password">Forgot Password</h2>
                                        <p class="profile-section-desc" data-tr="Mevcut şifrenizi bilmiyorsanız e-posta ve hesap numaranızla yeni şifre belirleyebilirsiniz."
                                            data-en="If you don't know your current password, set a new one with your email and account number.">
                                            If you don't know your current password, set a new one with your email and account number.
                                        </p>
                                        <div class="glass-card transfer-card profile-settings-card">
                                            <div class="transfer-form">
                                                <div class="form-group">
                                                    <label data-tr="E-posta" data-en="Email">Email</label>
                                                    <input type="email" id="profileResetEmail" class="neon-input" autocomplete="email">
                                                </div>
                                                <div class="form-group">
                                                    <label data-tr="Hesap Numarası" data-en="Account Number">Account Number</label>
                                                    <input type="text" id="profileResetAccountNo" class="neon-input" placeholder="VR-12345" autocomplete="off">
                                                </div>
                                                <div class="form-group">
                                                    <label data-tr="Yeni şifre" data-en="New password">New password</label>
                                                    <input type="password" id="profileResetNewPwd" class="neon-input" autocomplete="new-password">
                                                </div>
                                                <div class="form-group">
                                                    <label data-tr="Yeni şifre (tekrar)" data-en="Confirm new password">Confirm new password</label>
                                                    <input type="password" id="profileResetConfirmPwd" class="neon-input" autocomplete="new-password">
                                                </div>
                                                <button type="button" class="login-submit-btn" onclick="handleProfileForgotPassword()" data-tr="Şifreyi sıfırla" data-en="Reset password">Reset password</button>
                                            </div>
                                        </div>
                                    </div>
                                    </div>

                                    <div class="profile-layout-delete">
                                        <h2 class="sub-section-title danger-section-title" data-tr="Hesabımı Sil" data-en="Delete My Account">Delete My Account</h2>
                                        <div class="glass-card danger-zone-card profile-settings-card">
                                            <div class="danger-zone-header">
                                                <span class="danger-zone-icon" aria-hidden="true">⚠️</span>
                                                <div>
                                                    <h3 data-tr="Kalıcı hesap silme" data-en="Permanent account deletion">Permanent account deletion</h3>
                                                    <p data-tr="Bu işlem geri alınamaz. Aşağıdaki veriler kalıcı olarak silinir:"
                                                        data-en="This action cannot be undone. The following will be permanently removed:">
                                                        This action cannot be undone. The following will be permanently removed:
                                                    </p>
                                                </div>
                                            </div>
                                            <ul class="danger-zone-list">
                                                <li data-tr="Profil bilgileriniz ve giriş kaydınız" data-en="Your profile and login record">Your profile and login record</li>
                                                <li data-tr="Banka hesabınız ve bakiye bilgisi" data-en="Your bank account and balance">Your bank account and balance</li>
                                                <li data-tr="Tüm işlem geçmişi ve defter kayıtları" data-en="All transaction history and ledger entries">All transaction history and ledger entries</li>
                                                <li data-tr="Günlük limit ayarlarınız" data-en="Your daily limit settings">Your daily limit settings</li>
                                            </ul>
                                            <div class="transfer-form danger-zone-form">
                                                <div class="form-group">
                                                    <label data-tr="Mevcut şifreniz" data-en="Current password">Current password</label>
                                                    <input type="password" id="deleteAccountPassword" class="neon-input" autocomplete="current-password">
                                                </div>
                                                <div class="form-group">
                                                    <label data-tr="E-postanızı yazarak onaylayın" data-en="Confirm by typing your email">Confirm by typing your email</label>
                                                    <input type="email" id="deleteAccountEmailConfirm" class="neon-input" autocomplete="off">
                                                </div>
                                                <div class="form-group">
                                                    <label data-tr="Onay metni: HESABIMI SIL" data-en="Confirmation phrase: DELETE MY ACCOUNT">Confirmation phrase: DELETE MY ACCOUNT</label>
                                                    <input type="text" id="deleteAccountPhrase" class="neon-input" placeholder="DELETE MY ACCOUNT" data-tr-placeholder="HESABIMI SIL" data-en-placeholder="DELETE MY ACCOUNT" autocomplete="off">
                                                </div>
                                                <label class="danger-checkbox-label">
                                                    <input type="checkbox" id="deleteAccountAck">
                                                    <span data-tr="Sonuçları anladım; hesabımın kalıcı olarak silinmesini istiyorum."
                                                        data-en="I understand the consequences and want to permanently delete my account.">
                                                        I understand the consequences and want to permanently delete my account.
                                                    </span>
                                                </label>
                                                <button type="button" class="danger-delete-btn" id="deleteAccountBtn" onclick="handleDeleteAccount()" disabled
                                                    data-tr="Hesabımı kalıcı olarak sil" data-en="Permanently delete my account">
                                                    Permanently delete my account
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

