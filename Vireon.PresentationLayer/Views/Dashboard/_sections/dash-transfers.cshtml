<div class="dash-sub-section active" id="dash-transfers">
                                <h2 class="sub-section-title" data-tr="Para Gönder" data-en="Send Money">Send Money</h2>
                                <div class="glass-card transfer-card fx-rates-card">
                                    <h4 class="fx-rates-title" data-tr="Simülasyon Kurları (TRY baz)" data-en="Simulated Rates (TRY base)">Simulated Rates (TRY base)</h4>
                                    <div class="fx-rates-panel" id="fxRatesPanel"></div>
                                </div>
                                <div class="glass-card transfer-card">
                                    <div class="transfer-form">
                                        <div class="form-group">
                                            <label data-tr="Alıcı Hesap Numarası" data-en="Receiver Account Number">Receiver Account Number</label>
                                            <input type="text" id="transferTarget" placeholder="VR-0001" class="neon-input" oninput="lookupReceiverName()">
                                            <span class="receiver-name-hint" id="transferReceiverName"></span>
                                        </div>
                                        <div class="form-group fx-sim-group">
                                            <label data-tr="Kur simülasyonu (alıcı para birimi)" data-en="Rate simulator (receiver currency)">Rate simulator (receiver currency)</label>
                                            <select id="transferFxSimCurrency" class="neon-input">
                                                <option value="" data-tr="Gerçek alıcı hesabına göre" data-en="Use receiver account currency">Use receiver account currency</option>
                                                <option value="USD">USD — US Dollar</option>
                                                <option value="EUR">EUR — Euro</option>
                                                <option value="GBP">GBP — British Pound</option>
                                                <option value="TRY">TRY — Turkish Lira</option>
                                            </select>
                                            <p class="fx-sim-hint" data-tr="Demo hesaplar TRY olduğu için farklı para birimini buradan seçerek çapraz kur önizlemesi yapabilirsiniz."
                                                data-en="Demo accounts use TRY — pick another currency here to preview cross-rate conversion.">
                                                Demo accounts use TRY — pick another currency here to preview cross-rate conversion.
                                            </p>
                                        </div>
                                        <div class="form-group">
                                            <label id="transferAmountLabel" data-tr="Miktar (₺TRY)" data-en="Amount (₺TRY)">Amount (₺TRY)</label>
                                            <input type="number" id="transferAmount" placeholder="0.00" class="neon-input">
                                        </div>
                                        <div class="transfer-fx-preview" id="transferFxPreview">
                                            <span class="fx-preview-muted" data-tr="Tutar girince kur önizlemesi burada görünür." data-en="Enter an amount to preview the exchange rate.">Enter an amount to preview the exchange rate.</span>
                                        </div>
                                        <div class="form-group">
                                            <label data-tr="Açıklama" data-en="Description">Description</label>
                                            <input type="text" id="transferDesc" placeholder="Optional" class="neon-input" data-tr-placeholder="İsteğe bağlı" data-en-placeholder="Optional">
                                        </div>
                                        <button type="button" class="login-submit-btn" onclick="handleSendTransfer()" id="sendBtn" data-tr="Gönder" data-en="Send">Send</button>
                                    </div>
                                </div>
                            </div>

