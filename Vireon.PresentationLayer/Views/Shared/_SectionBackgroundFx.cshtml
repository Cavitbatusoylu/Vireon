<div class="section-bg-fx" aria-hidden="true">
    <div class="home-bg-fx__ring home-bg-fx__ring--1 section-bg-fx__ring"></div>
    <div class="home-bg-fx__ring home-bg-fx__ring--2 section-bg-fx__ring"></div>
    <div class="home-bg-fx__scan section-bg-fx__scan"></div>
    <div class="home-bg-fx__particles section-bg-fx__particles">
        @for (var i = 0; i < 14; i++)
        {
            <span class="home-particle" style="--i:@i"></span>
        }
    </div>
    <svg class="section-bg-fx__svg" viewBox="0 0 100 100" preserveAspectRatio="none">
        <line x1="18" y1="0" x2="18" y2="100" class="home-flow-line home-flow-line--v"/>
        <line x1="50" y1="0" x2="50" y2="100" class="home-flow-line home-flow-line--v"/>
        <line x1="82" y1="0" x2="82" y2="100" class="home-flow-line home-flow-line--v"/>
        <line x1="5" y1="25" x2="95" y2="25" class="home-flow-line"/>
        <line x1="5" y1="55" x2="95" y2="55" class="home-flow-line"/>
        <line x1="5" y1="85" x2="95" y2="85" class="home-flow-line"/>
        <circle r="1.4" class="home-flow-dot"><animateMotion dur="5s" repeatCount="indefinite" path="M50,0 L50,100"/></circle>
        <circle r="1.4" class="home-flow-dot"><animateMotion dur="6s" repeatCount="indefinite" path="M18,0 L18,100"/></circle>
        <circle r="1.4" class="home-flow-dot"><animateMotion dur="7s" repeatCount="indefinite" path="M5,25 L95,25"/></circle>
        <circle r="1.4" class="home-flow-dot"><animateMotion dur="8s" repeatCount="indefinite" path="M5,55 L95,55 L95,85"/></circle>
    </svg>
    <span class="home-gap-orb section-bg-fx__orb section-bg-fx__orb--1"></span>
    <span class="home-gap-orb section-bg-fx__orb section-bg-fx__orb--2"></span>
    <span class="home-gap-orb section-bg-fx__orb section-bg-fx__orb--3"></span>
    <span class="home-gap-orb section-bg-fx__orb section-bg-fx__orb--4"></span>
    <span class="home-gap-orb section-bg-fx__orb section-bg-fx__orb--5"></span>
    <span class="home-gap-orb section-bg-fx__orb section-bg-fx__orb--6"></span>
</div>
