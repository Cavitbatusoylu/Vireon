{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Vireon": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "../logs/vireon-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "ConnectionStrings": {
    "VireonDB": "Data Source=../Database/vireon_local.db"
  },
  "NeonAI": {
    "ApiToken": "",
    "ModelId": "llama-3.1-8b-instant"
  },
  "AllowedHosts": "*"
}
