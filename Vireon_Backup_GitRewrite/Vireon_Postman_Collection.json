{
  "info": {
    "name": "Vireon Digital Bank API",
    "description": "Vireon Sistemi için tüm uç noktaları kapsayan, jüri testleri ve Enes'in QA süreçleri için hazırlanmış Postman Koleksiyonu.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Tüm Hesapları Getir (GetAccounts)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://localhost:5202/api/Accounts", "protocol": "http", "host": ["localhost"], "port": "5202", "path": ["api", "Accounts"] }
          }
        },
        {
          "name": "Tek Hesap Getir (GetAccount)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://localhost:5202/api/Accounts/1", "protocol": "http", "host": ["localhost"], "port": "5202", "path": ["api", "Accounts", "1"] }
          }
        },
        {
          "name": "Hesap Oluştur (AddAccount)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"UserId\": 1,\n  \"AccountNumber\": \"TR1001-TEST\",\n  \"Balance\": 1000.00,\n  \"Currency\": \"TRY\"\n}" },
            "url": { "raw": "http://localhost:5202/api/Accounts", "protocol": "http", "host": ["localhost"], "port": "5202", "path": ["api", "Accounts"] }
          }
        },
        {
          "name": "Hesap Güncelle (UpdateAccount)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"AccountNumber\": \"TR1001-UPDATED\",\n  \"Balance\": 2500.00,\n  \"Currency\": \"USD\"\n}" },
            "url": { "raw": "http://localhost:5202/api/Accounts/1", "protocol": "http", "host": ["localhost"], "port": "5202", "path": ["api", "Accounts", "1"] }
          }
        },
        {
          "name": "Hesap Sil (DeleteAccount)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "http://localhost:5202/api/Accounts/1", "protocol": "http", "host": ["localhost"], "port": "5202", "path": ["api", "Accounts", "1"] }
          }
        }
      ]
    },
