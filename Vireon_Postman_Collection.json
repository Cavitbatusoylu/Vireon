          }
        },
        {
          "name": "Kullanıcı Sil",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "http://localhost:5202/api/Users/1", "protocol": "http", "host": ["localhost"], "port": "5202", "path": ["api", "Users", "1"] }
          }
        }
      ]
    }
  ]
